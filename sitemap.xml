---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign collections = site.collections | where_exp: 'collection', 'collection.output != false' %}
  {% for collection in collections %}
    {% assign documents = collection.docs | where_exp: 'document', 'document.sitemap != false' %}
    {% for document in documents %}
      <url>
        <loc>{{ document.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
        {% if document.last_modified_at %}
          <lastmod>{{ document.last_modified_at | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endfor %}
  {% endfor %}
  {% assign pages = site.html_pages | where_exp: 'document', 'document.sitemap != false' | where_exp: 'document', 'document.url != "/404.html"' %}
  {% for document in pages %}
    <url>
      <loc>{{ document.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
      {% if document.last_modified_at %}
        <lastmod>{{ document.last_modified_at | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
  {% endfor %}
  {% assign included_extensions = '.htm,.html,.xhtml,.pdf' | split: ',' %}
  {% assign static_files = site.static_files | where_exp: 'file', 'file.sitemap != false' | where_exp: 'file', 'file.name != "404.html"' %}
  {% for file in static_files %}
    {% if included_extensions contains file.extname %}
      <url>
        <loc>{{ file.path | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
        {% if file.last_modified_at %}
          <lastmod>{{ file.last_modified_at | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endif %}
  {% endfor %}
</urlset>
